{
  "extends": "@quasar/app-vite/tsconfig-preset",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "~/*": [
        "./src/*"
      ],
    },
  },
  // Учит языковой сервис Vue (редактор и vue-tsc) видеть pug-шаблоны:
  // без этого импорты, используемые только в шаблоне, помечаются как неиспользуемые
  // и удаляются авто-фиксами при сохранении
  "vueCompilerOptions": {
    "plugins": ["@vue/language-plugin-pug"]
  },
  "exclude": [
    "./dist",
    "./.quasar",
    "./node_modules",
    "./src-capacitor",
    "./src-cordova",
    "./quasar.config.*.temporary.compiled*"
  ]
}